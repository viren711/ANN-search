# =============================================================================
# Experiment configuration — sourced by run_all.sh. Edit here, not in the scripts.
# Any variable can also be overridden from the shell:  BUILD_THREADS=32 ./run_all.sh
# =============================================================================

# ---- threads -----------------------------------------------------------------
# Index construction (Vamana, HNSW, exact GT). Default: all logical CPUs.
BUILD_THREADS=${BUILD_THREADS:-$(nproc)}
# Query-time threads. MUST be identical for HNSW and Vamana (assignment rule). 1 = cleanest latency.
SEARCH_THREADS=${SEARCH_THREADS:-1}
# batch = all timing queries in one call (latency = wall/nq); single = one call per query
QUERY_MODE=${QUERY_MODE:-batch}
TIMING_QUERIES=${TIMING_QUERIES:-1000}   # fixed random subset (seed 0) used for timing only
REPEATS=${REPEATS:-5}                    # timing repeats (median reported)

# ---- datasets / PCA ----------------------------------------------------------
MAIN_DATASETS=${MAIN_DATASETS:-"sift1m quora nq"}
PCA_SAMPLE=${PCA_SAMPLE:-200000}
PCA_SEED=${PCA_SEED:-42}

# ---- Part 1: FAISS HNSW ------------------------------------------------------
HNSW_M=${HNSW_M:-32}
HNSW_EFC=${HNSW_EFC:-200}
HNSW_EF=${HNSW_EF:-"16 32 64 128 256 512 1024"}

# ---- Part 2/3: Vamana --------------------------------------------------------
VAMANA_R=${VAMANA_R:-64}
VAMANA_L=${VAMANA_L:-100}
VAMANA_ALPHA=${VAMANA_ALPHA:-1.2}
VAMANA_LS=${VAMANA_LS:-"10 20 30 50 75 100 150 200 300 500"}
SCALING_SIZES=${SCALING_SIZES:-"100000 250000 500000"}
SCALING_DATASETS=${SCALING_DATASETS:-"sift1m nq"}
# Part 3a configs "R,L_build,alpha": reference + R variants + alpha variants
PARAM_CONFIGS=${PARAM_CONFIGS:-"64,100,1.2 32,100,1.2 96,100,1.2 64,100,1.0 64,100,1.4"}
PARAM_LS=${PARAM_LS:-"10 20 30 50 75 100 150 200"}

# ---- Extra credit (disk-resident DiskANN on MS MARCO) ------------------------
EC_DATASET=${EC_DATASET:-msmarco}
EC_R=${EC_R:-64}
EC_L=${EC_L:-100}
EC_ALPHA=${EC_ALPHA:-1.2}
EC_PQ_M=${EC_PQ_M:-32}                   # PQ bytes per vector kept in RAM
EC_W=${EC_W:-4}                          # beam width (sector reads in flight per round)
EC_IO=${EC_IO:-fadvise}                  # fadvise | threads | serial
EC_LS=${EC_LS:-"50 100 200"}
EC_NUM_QUERIES=${EC_NUM_QUERIES:-1000}
EC_NUM_QUERIES_HDD=${EC_NUM_QUERIES_HDD:-200}
EC_RAM_LIMIT_GIB=${EC_RAM_LIMIT_GIB:-8}
# Where the disk index lives for the measurements. Empty = in place under indices/disk/.
# For EC2 set BOTH to directories on two *different physical* drives (one HDD, one SSD).
EC_SSD_DIR=${EC_SSD_DIR:-""}
EC_HDD_DIR=${EC_HDD_DIR:-""}
